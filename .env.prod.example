# ============ GameWeave 生产 / 部署环境变量 ============
# 复制为 .env，配合 docker-compose.prod.yml 使用。切勿提交真实密钥（.env 已 gitignore）。
#
# 与本地 .env.example 的区别：① 必须设强密码/密钥；② 三个 PUBLIC_* 公网地址；
# ③ 必须设 SITE_PASSWORD（整站访问密码，否则 prod compose 直接报错拒启）。

# ---- 公网地址（生产必须 HTTPS，HttpOnly 会话 Cookie 强制 Secure）----
# 注意：PUBLIC_API_URL 会在前端构建时被烧进客户端包，改了要重新 build web。
PUBLIC_WEB_URL=https://gameweave.example.com
PUBLIC_API_URL=https://api.gameweave.example.com
PUBLIC_S3_URL=https://assets.gameweave.example.com

# ---- 整站访问密码（必填，决定“不公开”）----
# 设置后：打开网站先要输入此密码；后端 API 也要求匹配令牌，直连后端被 401 挡掉。
SITE_PASSWORD=change-this-to-a-strong-passphrase
# Demo 实例可设 true：允许匿名浏览首页/Explore/Game/User/Play；Create/Studio/Auth 仍需密码门。
GATE_PUBLIC_BROWSE=false

# ---- PostgreSQL（请改强密码）----
POSTGRES_USER=gameweave
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=gameweave

# ---- 对象存储 MinIO（请改强密码；S3_ACCESS/SECRET 要与 ROOT 一致）----
MINIO_ROOT_USER=gameweave
MINIO_ROOT_PASSWORD=change-me-strong-minio-password
S3_ACCESS_KEY=gameweave
S3_SECRET_KEY=change-me-strong-minio-password
S3_BUCKET=gameweave
S3_REGION=us-east-1
# 容器内部地址（勿改）。浏览器用的公网地址由上面的 PUBLIC_S3_URL 提供。
S3_ENDPOINT=http://minio:9000

# ---- Redis（compose 内部，勿改）----
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_FAIL_OPEN=false
WORKER_MAX_MEMORY_PER_CHILD=500000
CELERY_VISIBILITY_TIMEOUT=7200
GENERATION_TASK_SOFT_TIME_LIMIT=3600
GENERATION_TASK_TIME_LIMIT=3900
GENERATION_OUTBOX_SCAN_INTERVAL_SECONDS=5
GENERATION_OUTBOX_BATCH_SIZE=100
GENERATION_LOCK_RETRY_SECONDS=3
TASK_EVENTS_ENABLED=true
TASK_EVENTS_HEARTBEAT_SECONDS=15

# ---- 构建期浏览器沙箱 / 用户并发 ----
# compose 内部地址，worker 会调用该服务进行真浏览器 QA。
SANDBOX_URL=http://sandbox:8001
SANDBOX_REQUIRED=true
SANDBOX_TIMEOUT_MS=5000
SANDBOX_HTTP_TIMEOUT_OVERHEAD_MS=10000
MAX_ACTIVE_TASKS_PER_USER=2
TASK_TOKEN_BUDGET=300000
# 宿主机已安装 gVisor 时建议 runsc；托管平台不支持自定义 runtime 时改 runc。
SANDBOX_RUNTIME=runsc
SANDBOX_RUNNER_CHROMIUM_NO_SANDBOX=true
SANDBOX_RUNNER_MAX_FILE_BYTES=16000000
SANDBOX_RUNNER_MAX_TOTAL_BYTES=64000000

# ---- 上传硬化 / 内容审核 ----
# ClamAV 可选：默认关闭以节省 1-1.5G 内存；启用时需同时启动 scan profile。
UPLOAD_SCAN=off
CLAMD_HOST=clamav
CLAMD_PORT=3310
# 生产建议 llm；首周可用 log 灰度观察误伤率，确认后改 enforce。
MODERATION_PROVIDER=llm
MODERATION_MODE=enforce
MODERATION_CACHE_TTL_SECONDS=86400

# ---- 鉴权 JWT（请改成长随机串）----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
AUTH_COOKIE_NAME=gameweave_session
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# ---- 模型服务 ----
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-5.5
MEMORY_VECTOR_ENABLED=true
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_VECTOR_DIMENSIONS=1536
MEMORY_ANN_CANDIDATES=120
MEMORY_HNSW_EF_SEARCH=100
# 留空时复用 OPENAI_API_KEY / OPENAI_BASE_URL
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_TIMEOUT=15
# 每个成功生成/修改任务固定调用一次；使用独立小模型一次性提取全部结构化 Claim
MEMORY_EXTRACTION_MODEL=gpt-4.1-mini
MEMORY_EXTRACTION_TIMEOUT=30
MEMORY_RRF_K=60
MEMORY_LEXICAL_MIN_SCORE=0.10
MEMORY_SEMANTIC_MIN_SCORE=0.20
OPENAI_TIMEOUT=600
OPENAI_CODE_TIMEOUT=1800
OPENAI_ALLOW_PARTIAL_CODE_STREAM=true
OPENAI_PARTIAL_STREAM_MIN_CHARS=2000
# 想在线上真生成游戏就设 true（需 OPENAI_* 配好）；只展示已有游戏可留 false。
USE_REAL_MODEL=true
# real 模式下模型调用失败后的策略：
#   false（默认）：重试后仍失败则任务失败，不回退 heuristic/template
#   true：保留旧行为，模型失败时回退 heuristic/template
REAL_MODEL_FALLBACK_ENABLED=false
OPENAI_MAX_RETRIES=2
OPENAI_RETRY_BACKOFF_SECONDS=1.5
# 修复 Agent 工具循环（openai-agents）。建议先 false 观察一段，再灰度 true；
# 任何失败自动回落旧的整体重生成，不会阻断任务。
CODE_AGENT_ENABLED=false
CODE_AGENT_MAX_TURNS=8
CODE_AGENT_MODEL=
# Optional; some OpenAI-compatible proxies reject prompt_cache_key.
CODE_AGENT_PROMPT_CACHE_KEY_PREFIX=
CODE_AGENT_AUTHOR_ENABLED=false
CODE_AGENT_AUTHOR_MAX_TURNS=32
# 高敏感/高容量调试开关：保存受单事件上限约束的 code-agent 追踪；生产默认必须关闭。
CODE_AGENT_DETAILED_LOGGING_ENABLED=false
CODE_AGENT_TRACE_PAYLOAD_WARN_CHARS=250000
CODE_AGENT_TRACE_MAX_PAYLOAD_CHARS=1000000
CODE_AGENT_TRACE_RETENTION_DAYS=7

# ---- Opik self-hosted trace export ----
# Set this to the internal/reachable Opik gateway URL in the deployment network.
OPIK_ENABLED=false
OPIK_URL_OVERRIDE=
OPIK_PROJECT_NAME=gameweave-agent
OPIK_WORKSPACE=default
OPIK_ENVIRONMENT=production
# 所有新 2D 游戏强制使用模块化 Phaser 3.90 + TypeScript，并先做类型检查。
VITE_BUILD_TIMEOUT_MS=120000

# 生产环境建议显式配置各模态供应商；local 只生成占位 SVG/WAV。
ASSET_GENERATION_ENABLED=false
ASSET_GENERATION_FAIL_OPEN=true
ASSET_GENERATION_MAX_ITEMS=20
ASSET_GENERATION_CONCURRENCY=2
ASSET_SHEET_MAX_PAGES=10
ASSET_BACKGROUND_VARIANTS=3
TILEMAP_GENERATION_ENABLED=true
ASSET_IMAGE_PROVIDER=local
ASSET_IMAGE_API_KEY=
ASSET_IMAGE_BASE_URL=
ASSET_IMAGE_MODEL=
ASSET_IMAGE_STREAMING_ENABLED=false
ASSET_IMAGE_PARTIAL_IMAGES=1
ASSET_AUDIO_PROVIDER=
ASSET_AUDIO_API_KEY=
ASSET_AUDIO_BASE_URL=
ASSET_AUDIO_MODEL=
ASSET_VIDEO_PROVIDER=
ASSET_VIDEO_API_KEY=
ASSET_VIDEO_BASE_URL=
ASSET_VIDEO_MODEL=

# ---- 可观测性 / 生成成本 ----
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
LOG_FORMAT=json
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLE_RATE=0.2
# 单位：美元 / 1M tokens；按实际模型供应商价格维护。
# MODEL_PRICING_JSON={"gpt-5.5":{"in":1.25,"out":10.0}}
MODEL_PRICING_JSON=

# ---- 第三方登录（可选，不用就留空；生产环境不回退 demo）----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 固定 demo 身份是共享账号入口，生产环境必须关闭。
ENABLE_OAUTH_DEMO=false
# 演示故障注入（force-repair/force-replan 触发修复回环），生产必须关闭。
DEMO_FAULT_INJECTION=false
# 生产 schema 只走 Alembic（compose 的 migrate 服务），create_all 兜底保持关闭。
# docker-compose.prod.yml 已对 api/worker 显式设 false，此处列出仅作说明。
AUTO_CREATE_ALL=false
