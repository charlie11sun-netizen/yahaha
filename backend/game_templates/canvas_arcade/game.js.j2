var ACCENT="{{ accent }}",WIN_SECONDS={{ duration }},HAZARD_SPEED={{ hazard_speed }},STAR_SPEED={{ star_speed }};
var c=document.getElementById("stage"),x=c.getContext("2d"),W,H;
function rs(){W=c.width=innerWidth;H=c.height=innerHeight}rs();onresize=rs;
var px=W/2,score=0,timeLeft=WIN_SECONDS,haz=[],stars=[],run=true,_lt=0,tmr,hazTick=0,starTick=0;
function spawnHaz(){var hx,tries=0;do{hx=40+Math.random()*(W-80);tries++}while(Math.abs(hx-px)<70&&tries<4);haz.push({x:hx,y:-30,s:26})}
function spawnStar(){stars.push({x:30+Math.random()*(W-60),y:-20,r:11})}
function startTimer(){clearInterval(tmr);tmr=setInterval(function(){timeLeft--;document.getElementById("tm").textContent=timeLeft;if(timeLeft<=0)over(true)},1000)}
function over(win){run=false;clearInterval(tmr);document.getElementById("ot").textContent=win?"You survived!":"Game Over";document.getElementById("of").textContent=score;document.getElementById("op").textContent=win?"final score":"score";document.getElementById("over").classList.add("show")}
function reset(){score=0;timeLeft=WIN_SECONDS;haz=[];stars=[];run=true;hazTick=0;starTick=0;document.getElementById("sc").textContent=0;document.getElementById("tm").textContent=WIN_SECONDS;document.getElementById("over").classList.remove("show");startTimer();loop()}
onmousemove=function(e){px=e.clientX};
ontouchmove=function(e){px=e.touches[0].clientX;e.preventDefault()};
onkeydown=function(e){if(e.key=="ArrowLeft")px=Math.max(0,px-40);if(e.key=="ArrowRight")px=Math.min(W,px+40)};
function loop(t){
  if(!run)return;requestAnimationFrame(loop);
  if(t-_lt<15)return;_lt=t;
  x.clearRect(0,0,W,H);
  var by=H-46;
  hazTick++;starTick++;
  var hazEvery=Math.max(34,70-Math.floor((WIN_SECONDS-timeLeft)/6));
  if(hazTick>=hazEvery){hazTick=0;spawnHaz()}
  if(starTick>=90){starTick=0;spawnStar()}
  for(var i=haz.length-1;i>=0;i--){var o=haz[i];o.y+=HAZARD_SPEED;
    x.fillStyle="#e2483d";x.fillRect(o.x-o.s/2,o.y-o.s/2,o.s,o.s);
    if(o.y>by-22&&o.y<by+18&&Math.abs(o.x-px)<34){over(false)}
    else if(o.y>H+30)haz.splice(i,1)}
  for(var j=stars.length-1;j>=0;j--){var s=stars[j];s.y+=STAR_SPEED;
    x.fillStyle=ACCENT;x.beginPath();
    for(var k=0;k<10;k++){var rr=k%2?s.r*.45:s.r,an=k*Math.PI/5-Math.PI/2;x.lineTo(s.x+Math.cos(an)*rr,s.y+Math.sin(an)*rr)}
    x.closePath();x.fill();
    if(s.y>by-22&&s.y<by+18&&Math.abs(s.x-px)<40){score+=10;document.getElementById("sc").textContent=score;stars.splice(j,1)}
    else if(s.y>H+30)stars.splice(j,1)}
  x.fillStyle=ACCENT;x.beginPath();x.moveTo(px-46,by+16);x.lineTo(px+46,by+16);x.lineTo(px+34,by-14);x.lineTo(px-34,by-14);x.closePath();x.fill();
  x.fillStyle="#181613";x.fillRect(px-34,by-14,68,5);
}
document.getElementById("rs").onclick=reset;
startTimer();loop();
