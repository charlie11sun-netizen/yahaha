<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title }}</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
<canvas id="stage"></canvas>
<div class="hud"><div>SCORE <b id="sc">0</b></div><div>TIME <b id="tm">{{ duration }}</b></div></div>
<div class="hint">{{ hint }}</div>
<div class="over" id="over"><h2 id="ot">Game Over</h2><div class="sc" id="of">0</div><p id="op">score</p><button class="btn" id="rs">Play again</button></div>
<script src="game.js"></script>
</body>
</html>
