var ACCENT="{{ accent }}",ROUND={{ duration }},TARGET={{ target_score }},LIVES={{ lives }},LANES={{ lanes }};
var FALL={{ hazard_speed }},SPAWN={{ hazard_spawn_ms }},STAR_MS={{ collectible_spawn_ms }},MAX_OBS={{ max_hazards }};
var c=document.getElementById("stage"),x=c.getContext("2d"),W=0,H=0,run=true,last=0,nextObs=0,nextStar=0;
var lane,score,lives,timeLeft,obs,stars,shake=0;
function size(){W=c.width=innerWidth;H=c.height=innerHeight}size();onresize=size;
function laneX(i){var pad=Math.max(70,W*.16),road=W-pad*2;return pad+road*(i+.5)/LANES}
function reset(){lane=Math.floor(LANES/2);score=0;lives=LIVES;timeLeft=ROUND;obs=[];stars=[];last=performance.now();nextObs=last+650;nextStar=last+500;shake=0;run=true;document.getElementById("over").classList.remove("show");tick(last)}
function finish(win){run=false;document.getElementById("ot").textContent=win?"Finish line!":"Crashed";document.getElementById("of").textContent=score;document.getElementById("op").textContent=win?"route score":"score";document.getElementById("over").classList.add("show")}
function spawnObs(now){if(obs.length>=MAX_OBS)return;var l=Math.floor(Math.random()*LANES);if(obs.length&&Math.random()<.35)l=(lane+Math.floor(Math.random()*2)*2-1+LANES)%LANES;obs.push({lane:l,y:-40,w:52,h:36,kind:Math.random()<.28?"gate":"rock"});nextObs=now+SPAWN+Math.random()*450}
function spawnStar(now){stars.push({lane:Math.floor(Math.random()*LANES),y:-20,r:13,p:0});nextStar=now+STAR_MS+Math.random()*420}
onkeydown=function(e){if(e.key=="ArrowLeft"||e.key=="a")lane=Math.max(0,lane-1);if(e.key=="ArrowRight"||e.key=="d")lane=Math.min(LANES-1,lane+1);if(e.key==" "&&!run)reset()};
ontouchstart=function(e){var px=e.touches[0].clientX;if(px<W/2)lane=Math.max(0,lane-1);else lane=Math.min(LANES-1,lane+1);e.preventDefault()};
onclick=function(e){if(!run)return;if(e.clientX<W/2)lane=Math.max(0,lane-1);else lane=Math.min(LANES-1,lane+1)};
function hit(a,b){return a.lane==b.lane&&Math.abs(a.y-b.y)<42}
function update(dt,now){
  timeLeft-=dt;if(timeLeft<=0||score>=TARGET){finish(score>=TARGET);return}
  if(now>nextObs)spawnObs(now);if(now>nextStar)spawnStar(now);
  var speed=FALL+Math.max(0,ROUND-timeLeft)*2.2;
  for(var i=obs.length-1;i>=0;i--){var o=obs[i];o.y+=speed*dt;if(o.y>H+60){obs.splice(i,1);score+=2;continue}if(hit({lane:lane,y:H-90},o)){lives--;shake=.25;obs.splice(i,1);if(lives<=0){finish(false);return}}}
  for(var j=stars.length-1;j>=0;j--){var s=stars[j];s.y+=(speed*.72)*dt;s.p+=dt*5;if(s.y>H+40){stars.splice(j,1);continue}if(hit({lane:lane,y:H-90},s)){score+=18;stars.splice(j,1)}}
  if(shake>0)shake-=dt
}
function drawStar(cx,cy,r){x.fillStyle=ACCENT;x.beginPath();for(var i=0;i<10;i++){var rr=i%2?r*.45:r,a=i*.628-1.57;x.lineTo(cx+Math.cos(a)*rr,cy+Math.sin(a)*rr)}x.closePath();x.fill()}
function draw(){
  var ox=shake>0?(Math.random()-.5)*10:0;x.save();x.translate(ox,0);
  var g=x.createLinearGradient(0,0,0,H);g.addColorStop(0,"#0f172a");g.addColorStop(1,"#2b183d");x.fillStyle=g;x.fillRect(0,0,W,H);
  var pad=Math.max(70,W*.16),road=W-pad*2;x.fillStyle="rgba(255,255,255,.06)";x.fillRect(pad,0,road,H);
  for(var i=0;i<=LANES;i++){var lx=pad+road*i/LANES;x.strokeStyle="rgba(255,255,255,.14)";x.setLineDash([18,18]);x.beginPath();x.moveTo(lx,0);x.lineTo(lx,H);x.stroke()}x.setLineDash([]);
  obs.forEach(function(o){var cx=laneX(o.lane),cy=o.y;x.fillStyle=o.kind=="gate"?"#ef4444":"#111827";x.strokeStyle=o.kind=="gate"?"#fecaca":"#f97316";x.lineWidth=3;x.beginPath();x.roundRect(cx-32,cy-24,64,48,10);x.fill();x.stroke()});
  stars.forEach(function(s){drawStar(laneX(s.lane),s.y,s.r)});
  var px=laneX(lane),py=H-90;x.fillStyle=ACCENT;x.beginPath();x.roundRect(px-30,py-24,60,48,14);x.fill();x.fillStyle="#111827";x.fillRect(px-16,py-7,32,14);x.restore();
  document.getElementById("sc").textContent=score;document.getElementById("tm").textContent=Math.ceil(timeLeft)+" L"+lives
}
function tick(now){if(!run)return;var dt=Math.min(.033,(now-last)/1000);last=now;update(dt,now);draw();requestAnimationFrame(tick)}
document.getElementById("rs").onclick=reset;reset();
