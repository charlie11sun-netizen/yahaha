var ACCENT="{{ accent }}",ROUND={{ duration }},TARGET={{ target_score }};
var TUTORIAL={{ tutorial_json }},REWARD_NAMES={{ reward_names_json }},POWERUPS={{ powerup_names_json }},WAVES={{ wave_script_json }};
var c=document.getElementById("stage"),x=c.getContext("2d"),W=0,H=0,N=5,grid=[],moves=0,timeLeft=ROUND,run=true,last=0;
function size(){W=c.width=innerWidth;H=c.height=innerHeight}size();onresize=size;
function piece(type,rot,path){return{type:type,rot:rot,path:!!path}}
function dirs(t){var d=t.type=="line"?[0,2]:[0,1];return d.map(function(v){return(v+t.rot)%4})}
function has(t,d){return dirs(t).indexOf(d)>=0}
function reset(){
  moves=0;timeLeft=ROUND;run=true;grid=[];
  var row=2;for(var y=0;y<N;y++){grid[y]=[];for(var xx=0;xx<N;xx++){grid[y][xx]=piece(Math.random()<.55?"line":"corner",Math.floor(Math.random()*4),false)}}
  for(var i=0;i<N;i++){grid[row][i]=piece("line",Math.floor(Math.random()*4),true)}
  grid[row][0].rot=1;grid[row][N-1].rot=1;document.getElementById("over").classList.remove("show");last=performance.now();tick(last)
}
function finish(win){run=false;var score=Math.max(0,TARGET-moves*8+Math.ceil(timeLeft)*3);document.getElementById("ot").textContent=win?"Circuit live":"Circuit dark";document.getElementById("of").textContent=score;document.getElementById("op").textContent=win?"moves "+moves:"try another route";document.getElementById("over").classList.add("show")}
function area(){var s=Math.min(W,H)*.72,ox=(W-s)/2,oy=(H-s)/2+10;return{s:s,cell:s/N,ox:ox,oy:oy}}
function connected(){
  var q=[],seen={};for(var y=0;y<N;y++){if(has(grid[y][0],3)){q.push([0,y]);seen["0,"+y]=1}}
  while(q.length){var p=q.shift(),cx=p[0],cy=p[1],t=grid[cy][cx];if(cx==N-1&&has(t,1))return true;
    [[0,-1,0,2],[1,0,1,3],[0,1,2,0],[-1,0,3,1]].forEach(function(e){var nx=cx+e[0],ny=cy+e[1];if(nx<0||ny<0||nx>=N||ny>=N)return;var k=nx+","+ny;if(seen[k])return;if(has(t,e[2])&&has(grid[ny][nx],e[3])){seen[k]=1;q.push([nx,ny])}})
  }return false
}
function rotateAt(px,py){if(!run)return;var a=area(),gx=Math.floor((px-a.ox)/a.cell),gy=Math.floor((py-a.oy)/a.cell);if(gx<0||gy<0||gx>=N||gy>=N)return;grid[gy][gx].rot=(grid[gy][gx].rot+1)%4;moves++;if(connected())finish(true)}
onclick=function(e){rotateAt(e.clientX,e.clientY)};
ontouchstart=function(e){rotateAt(e.touches[0].clientX,e.touches[0].clientY);e.preventDefault()};
onkeydown=function(e){if(e.key==" "&&!run)reset()};
function update(dt){timeLeft-=dt;if(timeLeft<=0)finish(false)}
function drawPipe(cx,cy,cell,t,on){
  var len=cell*.34;x.lineWidth=Math.max(8,cell*.09);x.lineCap="round";x.strokeStyle=on?ACCENT:"rgba(255,255,255,.32)";x.beginPath();x.moveTo(cx,cy);dirs(t).forEach(function(d){var ex=cx+(d==1?len:d==3?-len:0),ey=cy+(d==2?len:d==0?-len:0);x.moveTo(cx,cy);x.lineTo(ex,ey)});x.stroke();
  x.fillStyle=on?ACCENT:"#111827";x.beginPath();x.arc(cx,cy,x.lineWidth*.55,0,6.29);x.fill()
}
function draw(){
  var g=x.createLinearGradient(0,0,W,H);g.addColorStop(0,"#111827");g.addColorStop(1,"#182a3d");x.fillStyle=g;x.fillRect(0,0,W,H);
  var a=area();x.fillStyle="rgba(255,255,255,.06)";x.beginPath();x.roundRect(a.ox-18,a.oy-18,a.s+36,a.s+36,24);x.fill();
  for(var y=0;y<N;y++){for(var xx=0;xx<N;xx++){var cx=a.ox+a.cell*(xx+.5),cy=a.oy+a.cell*(y+.5);x.fillStyle="rgba(255,255,255,.08)";x.beginPath();x.roundRect(a.ox+xx*a.cell+6,a.oy+y*a.cell+6,a.cell-12,a.cell-12,12);x.fill();drawPipe(cx,cy,a.cell,grid[y][xx],grid[y][xx].path)}}
  x.fillStyle=ACCENT;x.font="700 16px ui-monospace,monospace";x.fillText("IN",a.ox-44,a.oy+a.cell*2.58);x.fillText("OUT",a.ox+a.s+12,a.oy+a.cell*2.58);
  x.fillStyle="rgba(255,255,255,.72)";x.font="700 13px ui-monospace,monospace";x.textAlign="center";x.fillText(TUTORIAL,W/2,H-28);x.textAlign="left";
  document.getElementById("sc").textContent=moves;document.getElementById("tm").textContent=Math.ceil(timeLeft)
}
function tick(now){if(!run)return;var dt=Math.min(.033,(now-last)/1000);last=now;update(dt);draw();requestAnimationFrame(tick)}
document.getElementById("rs").onclick=reset;reset();
