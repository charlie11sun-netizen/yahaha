# ============ PlayForge 环境变量示例 ============
# 复制为 .env 后按需填写。切勿提交真实密钥（.env 已被 .gitignore 忽略）。

# ---- PostgreSQL ----
POSTGRES_USER=playforge
POSTGRES_PASSWORD=playforge
POSTGRES_DB=playforge
# 本地直跑后端用 localhost；docker compose 会覆盖为服务名 postgres
DATABASE_URL=postgresql+psycopg://playforge:playforge@localhost:5432/playforge

# ---- Redis（Celery broker / result backend）----
REDIS_URL=redis://localhost:6379/0

# ---- 对象存储（MinIO，S3 兼容）----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=playforge
S3_REGION=us-east-1
# 浏览器加载远端 bundle 的公网地址；docker 内部为 http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000

# ---- 鉴权（JWT）----
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ---- 模型服务（OpenAI 兼容，如 Yahaha 提供的 GPT-5.5）----
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-5.5
# 生成链路是否调用真实模型；false 时走内置 mock 流水线（默认，离线可跑通）
USE_REAL_MODEL=false

# ---- 第三方登录（可选，留空则前端隐藏/降级）----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000

# ---- CORS / 前端 ----
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
