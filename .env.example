# ============ GameWeave 环境变量示例 ============
# 复制为 .env 后按需填写。切勿提交真实密钥（.env 已被 .gitignore 忽略）。

# ---- PostgreSQL ----
POSTGRES_USER=gameweave
POSTGRES_PASSWORD=gameweave
POSTGRES_DB=gameweave
# 本地直跑后端用 localhost；docker compose 会覆盖为服务名 postgres
DATABASE_URL=postgresql+psycopg://gameweave:gameweave@localhost:5432/gameweave

# ---- Redis（Celery broker / result backend）----
REDIS_URL=redis://localhost:6379/0
# 默认 false：限流 Redis 不可用时拒绝受保护请求；仅本地离线调试可临时设 true。
RATE_LIMIT_FAIL_OPEN=false
WORKER_MAX_MEMORY_PER_CHILD=500000
CELERY_VISIBILITY_TIMEOUT=7200
GENERATION_TASK_SOFT_TIME_LIMIT=3600
GENERATION_TASK_TIME_LIMIT=3900
GENERATION_OUTBOX_SCAN_INTERVAL_SECONDS=5
GENERATION_OUTBOX_BATCH_SIZE=100
GENERATION_LOCK_RETRY_SECONDS=3
TASK_EVENTS_ENABLED=true
TASK_EVENTS_HEARTBEAT_SECONDS=15

# ---- 对象存储（MinIO，S3 兼容）----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=gameweave
S3_REGION=us-east-1
# 浏览器加载远端 bundle 的公网地址；docker 内部为 http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000

# ---- 鉴权（JWT）----
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
AUTH_COOKIE_NAME=gameweave_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# ---- Schema 管理 ----
# true（默认）：启动时 create_all 兜底建表，适合本地开发。
# 生产置 false：schema 只走 Alembic 迁移（docker-compose.prod.yml 已内置），
# 避免 create_all 掩盖迁移缺口。
AUTO_CREATE_ALL=true

# ---- 演示故障注入（默认关闭）----
# true 时 prompt 含 force-repair / force-replan 会故意注入违禁 API 触发修复回环，
# 用于现场演示 repair loop。仅限本地演示开启。
DEMO_FAULT_INJECTION=false

# ---- 构建期浏览器沙箱 / 用户并发 ----
# docker compose 会覆盖为 http://sandbox:8001 且强制 required；裸跑后端/pytest
# 默认不依赖外部 sandbox，只保留 py_mini_racer 快速预检。
SANDBOX_URL=
SANDBOX_REQUIRED=false
SANDBOX_TIMEOUT_MS=5000
SANDBOX_HTTP_TIMEOUT_OVERHEAD_MS=10000
MAX_ACTIVE_TASKS_PER_USER=2
TASK_TOKEN_BUDGET=0
# dev compose 默认使用容器边界 + Chromium --no-sandbox 降级，确保离线可启动；
# 如已配置 Chromium seccomp/user namespace，可设为 false。
SANDBOX_RUNNER_CHROMIUM_NO_SANDBOX=true
SANDBOX_RUNNER_MAX_FILE_BYTES=2000000
SANDBOX_RUNNER_MAX_TOTAL_BYTES=5000000

# ---- 上传硬化 / 内容审核 ----
# UPLOAD_SCAN=off 时只做结构校验与图片重编码；设为 clamav 时同步调用 clamd，
# clamd 不可达会 fail-closed 返回 503。compose 的 clamav 是 optional profile。
UPLOAD_SCAN=off
CLAMD_HOST=clamav
CLAMD_PORT=3310
# 离线默认 blocklist；MODERATION_MODE=log 表示只记录 moderation_events，不拦截
# 一般用户内容。生成链路的 prompt-injection 类安全规则仍会在 safety_intake 中硬拦。
MODERATION_PROVIDER=blocklist
MODERATION_MODE=log
MODERATION_CACHE_TTL_SECONDS=86400

# ---- 模型服务（OpenAI 兼容，如 Yahaha 提供的 GPT-5.5）----
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-5.5
MEMORY_VECTOR_ENABLED=true
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_VECTOR_DIMENSIONS=1536
MEMORY_ANN_CANDIDATES=120
MEMORY_HNSW_EF_SEARCH=100
# 留空时复用 OPENAI_API_KEY / OPENAI_BASE_URL；聊天端点不支持 embeddings 时单独配置
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_TIMEOUT=15
# 每个成功生成/修改任务固定调用一次；使用独立小模型一次性提取全部结构化 Claim
MEMORY_EXTRACTION_MODEL=gpt-4.1-mini
MEMORY_EXTRACTION_TIMEOUT=30
MEMORY_RRF_K=60
MEMORY_LEXICAL_MIN_SCORE=0.10
MEMORY_SEMANTIC_MIN_SCORE=0.20
OPENAI_TIMEOUT=600            # 写整个 game.js 耗时长，单次调用超时秒数
OPENAI_CODE_TIMEOUT=1800      # 代码生成单次流式调用超时秒数
OPENAI_ALLOW_PARTIAL_CODE_STREAM=true
OPENAI_PARTIAL_STREAM_MIN_CHARS=2000
# 生成链路是否调用真实模型。
#   false（默认）：mock 流水线，离线可跑通，从模板产出可玩 bundle
#   true：走 LangGraph 真实链路（planner→designer→coder→sandbox QA，QA 不过自动重试），
#         需同时填好上面的 OPENAI_API_KEY / OPENAI_BASE_URL / MODEL_NAME
USE_REAL_MODEL=false
# real 模式下模型调用失败后的策略：
#   false（默认）：重试后仍失败则任务失败，不回退 heuristic/template
#   true：保留旧行为，模型失败时回退 heuristic/template
REAL_MODEL_FALLBACK_ENABLED=false
OPENAI_MAX_RETRIES=2
OPENAI_RETRY_BACKOFF_SECONDS=1.5

# ---- 修复 Agent（OpenAI Agents SDK 内层工具循环）----
# true：build/revision 修复节点改用工具循环 agent（read/write/run_checks 最小修复，
# 自测通过才提交；不可用或不收敛自动回落整体重生成）。gameplay QA 的浏览器运行时
# 报错（页面崩溃/console error/Phaser API 误用）也先走最小 patch 并回门禁复检，
# 只有玩法指标问题（太难/无输入/无循环）才整包重生成。仅 USE_REAL_MODEL=true 时生效。
CODE_AGENT_ENABLED=false
CODE_AGENT_MAX_TURNS=8
# 留空复用 MODEL_NAME；可单独指定更强模型专跑修复
CODE_AGENT_MODEL=

# ---- Phaser 2D 运行时试点 ----
# true：real 模式的 2D 代码生成改用自托管 Phaser 4（vendor/phaser.min.js 随包发布，
# 提示词内嵌官方 skills 蒸馏的 API 备忘单）。模板兜底与失败回退仍是 Canvas。
PHASER_2D_ENABLED=false

# ---- 可观测性 / 生成成本 ----
# 空值 = 本地离线关闭。生产建议 LOG_FORMAT=json，并把 OTEL endpoint 指向 Jaeger/OTLP 后端。
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
LOG_FORMAT=console
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLE_RATE=1.0
# 单位：美元 / 1M tokens；留空时使用后端内置默认表。示例：
# MODEL_PRICING_JSON={"gpt-5.5":{"in":1.25,"out":10.0}}
MODEL_PRICING_JSON=

# ---- 第三方登录（可选）----
# 填好 client id/secret 即启用真实 OAuth 授权码流程；本地可显式开启 demo 登录。
# 回调需在 Google/GitHub 后台登记为 {OAUTH_REDIRECT_BASE}/auth/oauth/{provider}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000
# OAuth 成功后重定向回前端的地址
FRONTEND_BASE_URL=http://localhost:3000
# 固定 demo 身份仅供本地演示；生产环境必须关闭。
ENABLE_OAUTH_DEMO=true

# ---- CORS / 前端 ----
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Next Server Components 访问 API 的服务端地址；Docker 内使用 http://api:8000。
# 未设置时回退到 NEXT_PUBLIC_API_BASE_URL。
API_INTERNAL_BASE_URL=http://localhost:8000

# ---- 整站访问密码（部署后的访问门禁）----
# 留空 = 不启用门禁（本地开发默认开放）。
# 设置后：①打开网站需先输入此密码（前端 Next middleware）；②后端 API 也要求
# 携带匹配的 X-Gate-Token（前端解锁后自动带上），直连后端将被 401 挡掉。
# 与用户注册/登录相互独立；密码仅服务端读取，cookie/请求头里是哈希令牌而非明文。
# 放行项：CORS 预检、/health(/ready)、/auth/oauth/*（OAuth 跳转/回调带不了头）。
SITE_PASSWORD=
# true 时公开首页 / explore / games / users / play 浏览和匿名游玩；登录、Create、Studio
# 仍需先通过站点密码门。默认 false 保持整站锁。
GATE_PUBLIC_BROWSE=false
